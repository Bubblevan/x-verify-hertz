# Server
PORT=8080

# X API (OAuth 1.0a read-only or app-only read)
# You can use either Bearer Token (recommended for read-only) or OAuth 1.0a credentials

# Option 1: Bearer Token (recommended for simple read-only access to public data)
# Get this from your X Developer Portal > Projects & Apps > your app > Keys and Tokens
X_BEARER_TOKEN=your_bearer_token_here

# Option 2: OAuth 1.0a credentials (if you don't have Bearer Token)
# These are the Consumer Key/Secret and Access Token/Secret from your X app
X_CONSUMER_KEY=your_consumer_key_here
X_CONSUMER_SECRET=your_consumer_key_secret_here
X_ACCESS_TOKEN=your_access_token_here
X_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# X API base URL
X_API_BASE_URL=https://api.x.com/2

# Verification tweet template
X_VERIFY_TWEET_PREFIX=I'm verifying my StablePay DID:
X_VERIFY_TWEET_TEMPLATE=I'm verifying my StablePay DID: {DID}

# Optional local front-end URL
FRONTEND_VERIFY_URL=http://127.0.0.1:3000/verify

# Encryption key for storing tokens (32 bytes base64 encoded)
# Generate with: openssl rand -base64 32
# Note: This is kept for backward compatibility but not used in current MVP
ENCRYPTION_KEY=your_base64_encoded_32byte_key_here
