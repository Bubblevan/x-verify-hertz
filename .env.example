# X OAuth 2.0 Configuration
X_CLIENT_ID=your_x_client_id_here
X_CLIENT_SECRET=your_x_client_secret_here
X_REDIRECT_URI=http://localhost:8080/api/v1/x/oauth/callback

# X OAuth Scopes (default: tweet.read users.read offline.access)
X_OAUTH_SCOPES=tweet.read users.read offline.access

# X API Endpoints
X_AUTHORIZE_URL=https://x.com/i/oauth2/authorize
X_TOKEN_URL=https://api.x.com/2/oauth2/token
X_API_BASE_URL=https://api.x.com/2

# Verification Tweet Template
X_VERIFY_TWEET_TEMPLATE=I'm verifying my StablePay DID: {DID}

# Frontend URL for redirect after OAuth
FRONTEND_VERIFY_URL=http://127.0.0.1:3000/verify

# Encryption key for storing tokens (32 bytes base64 encoded)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your_base64_encoded_32byte_key_here

# Server port
PORT=8080
